# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave pública: "publishable" (sb_publishable_...) o la antigua "anon"
NEXT_PUBLIC_SUPABASE_KEY=
# Clave secreta: "secret" (sb_secret_...) o la antigua "service_role". ¡Nunca la publiques!
SUPABASE_SECRET_KEY=
# Texto aleatorio largo para cifrar las IPs de los votantes
VOTE_SALT=cambia-esto-por-algo-largo-y-aleatorio

# Captcha Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Para probar en local puedes usar las claves de prueba de Cloudflare (siempre aprueban):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcionales (marca del certamen)
NEXT_PUBLIC_EVENT_LINE1=MISS VENEZUELA
NEXT_PUBLIC_EVENT_LINE2=PREMIUM
NEXT_PUBLIC_EVENT_TAGLINE=Belleza que inspira
NEXT_PUBLIC_FINALISTS=15
NEXT_PUBLIC_PUBLIC_VOTE_WEIGHT=0.2
